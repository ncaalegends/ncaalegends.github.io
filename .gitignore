# OS / editor noise
Thumbs.db
desktop.ini
.DS_Store
*.swp
.vscode/
.idea/

# Python bytecode cache — regenerated automatically by
# make-og-images.py, never worth versioning
__pycache__/
*.pyc

# Node packages. The site itself has no build step and no runtime
# dependencies — everything under tools/ is Node built-ins only, by
# design. This entry exists because test tooling (jsdom, for running
# the pages headlessly) is a local-only concern and must never end up
# in the repo that GitHub Pages serves.
node_modules/
package.json
package-lock.json

# Discord webhook URL — secret, never commit
tools/config.json

# Planning notes — working drafts, not part of the tooling docs
tools/SCOPING-*.md
